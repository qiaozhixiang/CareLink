<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 渐变顶部背景 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_login_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部说明区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="您好，欢迎使用"
                    android:textSize="16sp"
                    android:textColor="@color/white_80"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请选择您的身份"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不同身份将呈现不同的专属界面"
                    android:textSize="13sp"
                    android:textColor="@color/white_67"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <!-- 卡片区域 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/md3_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="40dp">

                    <!-- 老人端卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_elder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/elder_primary_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="24dp"
                            android:gravity="center_vertical">

                            <!-- 图标区域 -->
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_marginEnd="16dp">
                                <View
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/bg_role_elder_icon" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="👴"
                                    android:textSize="28sp" />
                            </FrameLayout>

                            <!-- 文字区域 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="我是老人"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/elder_primary" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="接收健康提醒，记录每日任务"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginTop="4dp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="健康打卡"
                                        android:textSize="11sp"
                                        android:textColor="@color/elder_secondary"
                                        android:background="@drawable/bg_tag_green"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp"
                                        android:layout_marginEnd="6dp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="一键求助"
                                        android:textSize="11sp"
                                        android:textColor="@color/elder_primary"
                                        android:background="@drawable/bg_tag_blue"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- 箭头 -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textSize="28sp"
                                android:textColor="@color/elder_primary"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 家属端卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_family"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/family_primary_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="24dp"
                            android:gravity="center_vertical">

                            <!-- 图标区域 -->
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_marginEnd="16dp">
                                <View
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/bg_role_family_icon" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="👨‍👩‍👧"
                                    android:textSize="26sp" />
                            </FrameLayout>

                            <!-- 文字区域 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="我是家属"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/family_primary" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="远程守护，实时了解老人状态"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginTop="4dp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="异常告警"
                                        android:textSize="11sp"
                                        android:textColor="@color/emergency_red"
                                        android:background="@drawable/bg_tag_red"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp"
                                        android:layout_marginEnd="6dp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="位置共享"
                                        android:textSize="11sp"
                                        android:textColor="@color/family_primary"
                                        android:background="@drawable/bg_tag_purple"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="3dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- 箭头 -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textSize="28sp"
                                android:textColor="@color/family_primary"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 说明文字 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ 选择后30天内无法切换身份，请谨慎选择"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="20dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
